# NextGen Marketplace Environment Configuration
# Copy this file to .env.local for development

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/nextgen_marketplace"
DATABASE_HOST="localhost"
DATABASE_PORT="5432"
DATABASE_NAME="nextgen_marketplace"
DATABASE_USER="your_db_user"
DATABASE_PASSWORD="your_db_password"

# Redis Configuration (for caching and sessions)
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Application Settings
NODE_ENV="development"
PORT="3000"
API_PORT="3001"
HOST="localhost"

# Service URLs
AUTH_SERVICE_URL="http://localhost:3001"
CATALOG_SERVICE_URL="http://localhost:3002"
ORDERS_SERVICE_URL="http://localhost:3003"
ML_SERVICE_URL="http://localhost:3004"

# JWT Settings
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRE_TIME="24h"
REFRESH_TOKEN_SECRET="your-refresh-token-secret-change-this"
REFRESH_TOKEN_EXPIRE_TIME="7d"

# Zarinpal Payment Gateway
ZARINPAL_MERCHANT_ID="your-zarinpal-merchant-id"
ZARINPAL_SANDBOX="true"
ZARINPAL_CALLBACK_URL="http://localhost:3000/payment/callback"

# File Upload & Storage
UPLOAD_PATH="uploads"
MAX_FILE_SIZE="10485760"  # 10MB in bytes
ALLOWED_FILE_TYPES="jpg,jpeg,png,pdf,doc,docx"

# Email Configuration (for notifications)
EMAIL_FROM="noreply@nextgen-marketplace.com"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"

# SMS Configuration (for OTP and notifications)
SMS_API_KEY="your-sms-api-key"
SMS_SENDER="NextGenMarketplace"

# External APIs
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
IRAN_POST_API_KEY="your-iran-post-api-key"

# AI & Analytics
AI_RECOMMENDATION_ENABLED="true"
ANALYTICS_ENABLED="true"
LOG_LEVEL="debug"

# Security
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"

# Search & Indexing
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX_PREFIX="nextgen_marketplace"

# Qdrant Vector Database (for ML embeddings)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_COLLECTION_NAME="product_embeddings"

# MinIO Object Storage
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET_NAME="nextgen-marketplace"
MINIO_USE_SSL="false"

# Machine Learning Service
ML_SERVICE_URL="http://localhost:3004"
ML_MODEL_PATH="/app/models"
ML_ENABLE_GPU="false"
ML_BATCH_SIZE="32"
ML_MAX_RECOMMENDATIONS="10"

# Monitoring & Logging
SENTRY_DSN="your-sentry-dsn"
NEW_RELIC_LICENSE_KEY="your-newrelic-license-key"

# Development Tools
DEBUG="nextgen:*"
ENABLE_SWAGGER="true"
ENABLE_PLAYGROUND="true"

# Resend email service (used for password reset)
RESEND_API_KEY="replace_with_resend_api_key"
EMAIL_FROM="noreply@nextgen-marketplace.com"

# Blockchain (Alchemy Sepolia)
ALCHEMY_API_URL="https://eth-sepolia.g.alchemy.com/v2/your_api_key"
PRIVATE_KEY="replace_with_private_key"
NFT_CONTRACT_ADDRESS="0xYourNFTContract"