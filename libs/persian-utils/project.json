{
  "name": "persian-utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/persian-utils/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/persian-utils",
        "main": "libs/persian-utils/src/index.ts",
        "tsConfig": "libs/persian-utils/tsconfig.lib.json",
        "assets": ["libs/persian-utils/*.md"],
        "format": ["cjs"],
        "platform": "node",
        "bundle": true,
        "thirdParty": false
      },
      "configurations": {
        "production": {
          "minify": true,
          "optimization": true
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
        "options": {
        "jestConfig": "libs/persian-utils/jest.config.ts"
      }
    }
  }
}
