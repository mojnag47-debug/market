{
  "name": "@nextgen-marketplace/backend",
  "version": "1.0.0",
  "description": "NextGen Marketplace Backend Microservices",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:auth\" \"npm run dev:users\" \"npm run dev:products\" \"npm run dev:orders\"",
    "dev:auth": "nodemon --exec ts-node src/services/auth/server.ts",
    "dev:users": "nodemon --exec ts-node src/services/users/server.ts",
    "dev:products": "nodemon --exec ts-node src/services/products/server.ts",
    "dev:orders": "nodemon --exec ts-node src/services/orders/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageThreshold='{\"global\":{\"branches\":80,\"functions\":80,\"lines\":80,\"statements\":80}}'",
    "test:ci": "jest --coverage --ci --watchAll=false",
    "test:db:setup": "DATABASE_URL=$TEST_DATABASE_URL npx prisma migrate deploy && DATABASE_URL=$TEST_DATABASE_URL npx prisma db seed",
    "test:db:teardown": "DATABASE_URL=$TEST_DATABASE_URL npx prisma migrate reset --force",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "security:check": "npm run security:audit && npm run security:outdated",
    "security:outdated": "npm outdated",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node src/database/seed.ts",
    "ci:prepare": "npm ci && npm run db:generate",
    "ci:test": "npm run lint && npm run type-check && npm run test:ci && npm run security:check"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "xss": "^1.0.14",
    "hpp": "^0.2.3",
    "cookie-parser": "^1.4.6",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.0",
    "redis": "^4.6.10",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.9",
    "@types/bcryptjs": "^2.4.6",
    "@types-jsonwebtoken": "^9.0.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^9.0.7",
    "@types/multer": "^1.4.11",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.8",
    "@types/supertest": "^2.0.16",
    "@types/hpp": "^0.2.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/express-session": "^1.17.10",
    "typescript": "^5.9.2",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "prettier": "^3.1.1",
    "concurrently": "^8.2.2",
    "prisma": "^5.7.1",
    "jest-environment-node": "^29.7.0",
    "@faker-js/faker": "^8.3.1",
    "cross-env": "^7.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/__tests__/**/*.ts", "**/?(*.)+(spec|test).ts"],
    "setupFilesAfterEnv": ["<rootDir>/src/tests/setup.ts"],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/database/seed.ts",
      "!src/**/server.ts",
      "!src/tests/**/*.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html", "json"],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testTimeout": 30000,
    "verbose": true,
    "transform": {
      "^.+\\.(t|j)sx?$": ["@swc/jest", { "jsc": { "parser": { "tsx": true }, "target": "es2022" } }]
    }
  }
}