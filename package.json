{
  "name": "nextgen-marketplace",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "workspaces": [
    "apps/*",
    "libs/*",
    "tools/*"
  ],
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} --transpile-only prisma/seed.ts"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm exec nx run-many --target=build --all",
    "dev": "pnpm exec nx run-many --target=dev --all --parallel",
    "test": "pnpm exec nx run-many --target=test --all",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false pnpm exec nx run-many --target=lint --all",
    "format": "prettier --write .",
    "clean": "pnpm exec nx reset && rm -rf node_modules apps/*/node_modules libs/*/node_modules tools/*/node_modules",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:ts": "ts-node --compiler-options {\"module\":\"CommonJS\"} --transpile-only prisma/seed.ts",
    "db:studio": "prisma studio",
    "token:gen": "node tools/generate-token.js",
    "test:upload": "jest --config=tools/jest/jest.ar.config.js --runInBand src/__tests__/upload.test.ts",
    "test:e2e": "playwright test e2e --project=chromium",
    "test:ar": "jest --config=tools/jest/jest.ar.config.js --runInBand src/__tests__/ar-assets.test.ts",
    "test:webhook": "jest --runInBand --testPathPattern=apps/api/src/controllers/webhookController.test.ts",
    "test:integration": "jest --runInBand --testPathPattern=apps/api/src/modules/auth/auth.integration.test.ts",
    "docker:up": "docker-compose -f docker/docker-compose.dev.yml up -d",
    "docker:down": "docker-compose -f docker/docker-compose.dev.yml down"
  },
  "dependencies": {
    "@google/model-viewer": "^4.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@nx/esbuild": "^21.6.2",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.51.23",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/winston": "^2.4.4",
    "autoprefixer": "^10.4.19",
    "axios": "^1.6.0",
    "bcryptjs": "2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.544.0",
    "morgan": "^1.10.1",
    "next": "~15.2.5",
    "next-themes": "^0.4.6",
    "playwright": "^1.55.1",
    "postcss": "^8.4.39",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.63.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^3.4.17",
    "three": "^0.176.0",
    "winston": "^3.18.1",
    "redis": "^4.6.7",
    "resend": "^1.10.0",
    "zod": "^3.25.76",
    "express-mongo-sanitize": "^2.2.0",
    "xss-clean": "^0.1.1",
    "pino-http": "^7.0.0",
    "multer": "^1.4.5-lts.1",
    "ethers": "^6.9.0",
    "cockatiel": "^5.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.894.0",
    "@aws-sdk/s3-request-presigner": "^3.894.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@nx/eslint-plugin": "^21.6.2",
    "@nx/jest": "^21.5.3",
    "@nx/next": "^21.6.2",
    "@nx/node": "^21.5.3",
    "@nx/vite": "^21.6.2",
    "@playwright/test": "^1.55.1",
    "@swc/core": "1.13.5",
    "@swc/jest": "0.2.39",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.19.9",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "0.180.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@upstash/redis": "^1.35.4",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^7.0.3",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.0",
    "jsonwebtoken": "^9.0.2",
    "minimist": "^1.2.8",
    "nx": "^21.6.2",
    "prisma": "5.22.0",
    "ts-mockito": "^2.6.1",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.2",
    "uuid": "^13.0.0",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4",
    "testcontainers": "^9.0.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12",
    "@types/redis": "^4.0.12",
    "@types/cookie-parser": "^1.4.6",
    "hardhat": "^2.17.0"
  }
}
